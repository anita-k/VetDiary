@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<p class="text-muted">Overview of your Vet Diary system</p>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Clients</h5>
                <p class="card-text display-6">@ViewBag.TotalClients</p>
                <a asp-area="" asp-controller="Clients" asp-action="Index" class="text-white">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Pets</h5>
                <p class="card-text display-6">@ViewBag.TotalPets</p>
                <a asp-area="" asp-controller="Pets" asp-action="Index" class="text-white">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">Diary Entries</h5>
                <p class="card-text display-6">@ViewBag.TotalDiaryEntries</p>
                <a asp-area="" asp-controller="DiaryEntries" asp-action="Index" class="text-white">View All</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Species</h5>
                <p class="card-text display-6">@ViewBag.TotalSpecies</p>
                <a asp-area="" asp-controller="Species" asp-action="Index" class="text-dark">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Breeds</h5>
                <p class="card-text display-6">@ViewBag.TotalBreeds</p>
                <a asp-area="" asp-controller="Breeds" asp-action="Index" class="text-dark">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Visit Reasons</h5>
                <p class="card-text display-6">@ViewBag.TotalVisitReasons</p>
                <a asp-area="" asp-controller="VisitReasons" asp-action="Index" class="text-dark">View All</a>
            </div>
        </div>
    </div>
</div>
