@model IEnumerable<VetDiary.ViewModels.DiaryEntry.DiaryEntryIndexViewModel>

@{
    ViewData["Title"] = "Diary Entries";
    string? currentSort = ViewBag.SortBy as string;
    bool currentDesc = (bool)(ViewBag.SortDesc ?? false);
    string? searchTerm = ViewBag.SearchTerm as string;
    int? visitReasonId = ViewBag.VisitReasonId as int?;
}

<h1>Diary Entries</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <a class="btn btn-primary" asp-action="Create">Create New</a>
    </div>
    <div class="col-md-8">
        <form method="get" class="d-flex">
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control me-2" 
            placeholder="Search by pet, owner, visit reason or description..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string) || ViewBag.VisitReasonId != null)
            {
                <a asp-action="Index" class="btn btn-outline-danger ms-1">Clear</a>
            }
        </form>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortBy="date" asp-route-sortDesc="@(currentSort == "date" && !currentDesc)" asp-route-searchTerm="@searchTerm" asp-route-visitReasonId="@visitReasonId">
                    Visit Date @(currentSort == "date" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="pet" asp-route-sortDesc="@(currentSort == "pet" && !currentDesc)" asp-route-searchTerm="@searchTerm" asp-route-visitReasonId="@visitReasonId">
                    Pet @(currentSort == "pet" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="client" asp-route-sortDesc="@(currentSort == "client" && !currentDesc)" asp-route-searchTerm="@searchTerm" asp-route-visitReasonId="@visitReasonId">
                    Client @(currentSort == "client" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="reason" asp-route-sortDesc="@(currentSort == "reason" && !currentDesc)" asp-route-searchTerm="@searchTerm" asp-route-visitReasonId="@visitReasonId">
                    Visit Reason @(currentSort == "reason" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">
                    @Html.DisplayFor(modelItem => item.VisitDate)
                </a>
            </td>
            <td>
                <a asp-controller="Pets" asp-action="Details" asp-route-id="@item.Pet.Id">
                        @Html.DisplayFor(modelItem => item.Pet.Name)
                </a>
            </td>
            <td>
                <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.Pet.Client.Id">
                    @Html.DisplayFor(modelItem => item.Pet.Client.FullName)
                </a>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VisitReason.Name)
            </td>

            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<partial name="_PaginationPartial" />
