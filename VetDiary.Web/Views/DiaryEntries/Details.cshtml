@model VetDiary.ViewModels.DiaryEntry.DiaryEntryDetailsViewModel

@{
    ViewData["Title"] = "Details";
}
<div class="container">
    <div class="row">
        <div class="col-12">
            <h1>Diary Entry Details</h1>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-6">
            <div>
                <h4>Diary Entry</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.VisitDate)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.VisitDate)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.VisitReason)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.VisitReason.Name)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Description)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Description)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Weight)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Weight)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Temperature)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Temperature)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pulse)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Pulse)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Behaviour)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Behaviour)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.BodyConditionScore)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.BodyConditionScore)
                    </dd>
                </dl>
            </div>
        </div>
        <div class="col-6">
            <div>
                <h4>Pet</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pet.Name)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Pet.Name)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pet.Gender)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Pet.Gender)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pet.IsNeutered)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Pet.IsNeutered)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pet.BirthDate)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Pet.BirthDate)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pet.MicrochipNumber)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Pet.MicrochipNumber)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pet.PassportNumber)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Pet.PassportNumber)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pet.Client)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Pet.Client.FirstName)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pet.Species)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Pet.Species.Icon)
                        @Html.DisplayFor(model => model.Pet.Species.Name)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Pet.Breed)
                    </dt>
                    <dd class="col-sm-8">
                        @(Model?.Pet.Breed?.Name)
                    </dd>
                </dl>
            </div>
            <div>
                <h4>Client</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Pet.Client.FirstName)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Pet.Client.FirstName)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Pet.Client.LastName)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Pet.Client.LastName)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Pet.Client.Phone)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Pet.Client.Phone)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Pet.Client.Email)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Pet.Client.Email)
                    </dd>
                </dl>
            </div>

        </div>

    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
