@model IEnumerable<VetDiary.ViewModels.Species.SpeciesIndexViewModel>

@{
    ViewData["Title"] = "Species";
    string? currentSort = ViewBag.SortBy as string;
    bool currentDesc = (bool)(ViewBag.SortDesc ?? false);
    string? searchTerm = ViewBag.SearchTerm as string;
}

<h1>Species</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <a class="btn btn-primary" asp-action="Create">Create New</a>
    </div>
    <div class="col-md-6">
        <form method="get" class="d-flex">
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control me-2" placeholder="Search species..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a asp-action="Index" class="btn btn-outline-danger ms-1">Clear</a>
            }
        </form>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortBy="name" asp-route-sortDesc="@(currentSort == "name" && !currentDesc)" asp-route-searchTerm="@searchTerm">
                    Name @(currentSort == "name" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Icon)
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<partial name="_PaginationPartial" />
