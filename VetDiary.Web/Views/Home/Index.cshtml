@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<div class="vet-hero text-center">
    <h1 class="display-5 mb-3">Welcome to VetDiary</h1>
    <p class="lead mb-4">Your complete veterinary practice management solution. Track clients, patients, and diary entries all in one place.</p>
    <a asp-controller="DiaryEntries" asp-action="Index" class="btn btn-light btn-lg">Open Diary</a>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-5">
    <div class="col-md-6 col-lg-3">
        <a asp-controller="Clients" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 text-center p-3">
                <div class="card-body">
                    <div class="card-icon">👨‍👨</div>
                    <h5 class="card-title">Clients</h5>
                    <p class="card-text text-muted">Manage pet owners, contact details, and client records.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-controller="Pets" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 text-center p-3">
                <div class="card-body">
                    <div class="card-icon">🐾</div>
                    <h5 class="card-title">Pets</h5>
                    <p class="card-text text-muted">View and manage patient profiles, species and breeds.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-controller="DiaryEntries" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 text-center p-3">
                <div class="card-body">
                    <div class="card-icon">🗓️</div>
                    <h5 class="card-title">Diary</h5>
                    <p class="card-text text-muted">Record visits, track pet condition, and review appointment history.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-controller="Pets" asp-action="Create" class="text-decoration-none">
            <div class="card h-100 text-center p-3">
                <div class="card-body">
                    <div class="card-icon"><span>&#129658;</span></div>
                    <h5 class="card-title">New Patient</h5>
                    <p class="card-text text-muted">Register a new pet patient into the system.</p>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Feature Highlights -->
<div class="vet-features mb-5">
    <h3 class="text-center mb-4">Feature Highlights</h3>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 p-3">
                <div class="card-body">
                    <div class="card-icon">📋</div>
                    <h5 class="card-title">Client Management</h5>
                    <p class="card-text text-muted">Maintain a complete registry of pet owners with contact information and linked pet records.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 p-3">
                <div class="card-body">
                    <div class="card-icon">🏥</div>
                    <h5 class="card-title">Visit Tracking</h5>
                    <p class="card-text text-muted">Log every consultation with visit dates, reasons, and notes for a full medical history.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 p-3">
                <div class="card-body">
                    <div class="card-icon">🧬</div>
                    <h5 class="card-title">Species & Breeds</h5>
                    <p class="card-text text-muted">Configure species and breeds to keep patient records consistent.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Getting Started CTA -->
<div class="text-center mb-5">
    <h3 class="mb-3">Get Started</h3>
    <p class="text-muted mb-4">Begin by adding clients and recording diary entries.</p>
    <a asp-controller="Clients" asp-action="Create" class="btn btn-primary btn-lg me-2">Add a Client</a>
    <a asp-controller="DiaryEntries" asp-action="Create" class="btn btn-outline-primary btn-lg">New Diary Entry</a>
</div>