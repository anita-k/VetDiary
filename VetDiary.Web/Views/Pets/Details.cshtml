@model VetDiary.ViewModels.Pet.PetDetailsViewModel

@{
    ViewData["Title"] = "Details";
}
<div class="container">
    <div class="row">
        <div class="col-12">
            <h1>Pet Details: @Html.DisplayFor(model => model.Name)</h1>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-6">
            <div>
                <h4>Pet</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Name)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Gender)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Gender)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.IsNeutered)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.IsNeutered)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.BirthDate)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.BirthDate)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.MicrochipNumber)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.MicrochipNumber)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.PassportNumber)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.PassportNumber)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Client)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Client.FirstName)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Species)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Species.Icon)
                        @Html.DisplayFor(model => model.Species.Name)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Breed)
                    </dt>
                    <dd class="col-sm-8">
                        @(Model?.Breed?.Name)
                    </dd>
                </dl>
            </div>
        </div>
        <div class="col-6">

            <div>
                <h4>Client</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Client.FullName)
                    </dt>
                    <dd class="col-sm-10">
                        <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model?.ClientId">
                            @Html.DisplayFor(model => model.Client.FullName)
                        </a>
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Client.Phone)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Client.Phone)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Client.Email)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Client.Email)
                    </dd>
                </dl>
            </div>

            <div>
                <h4>Diary Entries</h4>
                <hr />

                @if (Model?.DiaryEntries.Count > 0)
                {
                 <table class="table">
                    <thead>
                        <tr>
                            <th>
                                Visit Date
                            </th>
                            <th>
                                Pet
                            </th>
                            <th>
                                Client
                            </th>
                            <th>
                                Visit Reason
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DiaryEntries)
                        {
                            <tr>
                                <td>
                                        <a asp-controller="DiaryEntries" asp-action="Details" asp-route-id="@item.Id">
                                        @Html.DisplayFor(modelItem => item.VisitDate)
                                    </a>
                                </td>
                                <td>
                                    <a asp-controller="Pets" asp-action="Details" asp-route-id="@item.Pet.Id">
                                        @Html.DisplayFor(modelItem => item.Pet.Name)
                                    </a>
                                </td>
                                <td>
                                    <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.Pet.Client.Id">
                                        @Html.DisplayFor(modelItem => item.Pet.Client.FullName)
                                    </a>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.VisitReason.Name)
                                </td>

                                <td>
                                        <a asp-controller="DiaryEntries" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                                        <a asp-controller="DiaryEntries" asp-action="Details" asp-route-id="@item.Id">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                    
                } else
                {
                   <div>No diary entries.</div>
                }

            </div>

        </div>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-controller="DiaryEntries" asp-action="Create" asp-route-petId="@Model?.Id">Add Diary Entry</a> |
    <a asp-action="Index">Back to List</a>
</div>
