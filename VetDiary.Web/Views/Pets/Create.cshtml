@using VetDiary.Shared
@model VetDiary.ViewModels.Pet.PetCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Pet</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gender" class="control-label"></label>
                <select asp-for="Gender"
                        asp-items="Html.GetEnumSelectList<PetGender>()"
                        class="form-control">
                    <option value="">Select gender ...</option>
                </select>
            </div>
            <div class="form-group">
                <label class="control-label">Neutered?</label>
                <div class="form-check">
                    <input type="radio" asp-for="IsNeutered" value="" class="form-check-input" id="neutered-unknown" />
                    <label class="form-check-label" for="neutered-unknown">Unknown / Not specified</label>
                </div>
                <div class="form-check">
                    <input type="radio" asp-for="IsNeutered" value="true" class="form-check-input" id="neutered-yes" />
                    <label class="form-check-label" for="neutered-yes">Yes</label>
                </div>
                <div class="form-check">
                    <input type="radio" asp-for="IsNeutered" value="false" class="form-check-input" id="neutered-no" />
                    <label class="form-check-label" for="neutered-no">No</label>
                </div>
                <span asp-validation-for="IsNeutered" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BirthDate" class="control-label"></label>
                <input asp-for="BirthDate" class="form-control" type="date"/>
                <span asp-validation-for="BirthDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MicrochipNumber" class="control-label"></label>
                <input asp-for="MicrochipNumber" class="form-control" />
                <span asp-validation-for="MicrochipNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PassportNumber" class="control-label"></label>
                <input asp-for="PassportNumber" class="form-control" />
                <span asp-validation-for="PassportNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClientId" class="control-label"></label>
                <select asp-for="ClientId" class="form-control" asp-items="@(new SelectList(Model.Clients, "Id", "FullName"))"></select>
            </div>
            <div class="form-group">
                <label asp-for="SpeciesId"></label>
                <select asp-for="SpeciesId"
                        id="speciesSelect"
                        class="form-control"
                        asp-items="@(new SelectList(Model.Species, "Id", "Name"))">
                    <option value="">-- Select Species --</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="BreedId"></label>
                <select asp-for="BreedId"
                        id="breedSelect"
                        class="form-control"
                        disabled>
                    <option value="">-- Select Breed --</option>
                </select>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>


@section Scripts {
    <script>
        const speciesSelect = document.getElementById("speciesSelect");
        const breedSelect = document.getElementById("breedSelect");

        speciesSelect.addEventListener("change", function () {
            const speciesId = this.value;

            // reset
            breedSelect.innerHTML = '<option value="">-- Select Breed --</option>';
            breedSelect.disabled = true;

            if (!speciesId) return;

            fetch(`/Breeds/GetBreedsBySpecies?speciesId=${speciesId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.result.length === 0) {
                        breedSelect.disabled = true;
                        return;
                    }

                    data.result.forEach(b => {
                        const option = document.createElement("option");
                        option.value = b.id;
                        option.text = b.name;
                        breedSelect.appendChild(option);
                    });

                    breedSelect.disabled = false;
                });
        });

    </script>
}
