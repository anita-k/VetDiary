@model IEnumerable<VetDiary.ViewModels.Pet.PetIndexViewModel>

@{
    ViewData["Title"] = "Pets";
    string? currentSort = ViewBag.SortBy as string;
    bool currentDesc = (bool)(ViewBag.SortDesc ?? false);
    string? searchTerm = ViewBag.SearchTerm as string;
    int? speciesId = ViewBag.SpeciesId as int?;
}

    <h1>Pets</h1>

    <div class="row mb-3">
        <div class="col-md-4">
            <a class="btn btn-primary" asp-action="Create">Create New</a>
        </div>
        <div class="col-md-8">
            <form method="get" class="d-flex">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control me-2" 
                placeholder="Search by pet or owner name, microchip or passport number" />
                <button type="submit" class="btn btn-outline-secondary">Search</button>
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string) || ViewBag.SpeciesId != null)
                {
                    <a asp-action="Index" class="btn btn-outline-danger ms-1">Clear</a>
                }
            </form>
        </div>
    </div>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortBy="id" asp-route-sortDesc="@(currentSort == "id" && !currentDesc)" asp-route-searchTerm="@searchTerm" asp-route-speciesId="@speciesId">
                    # @(currentSort == "id" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="name" asp-route-sortDesc="@(currentSort == "name" && !currentDesc)" asp-route-searchTerm="@searchTerm" asp-route-speciesId="@speciesId">
                    Name @(currentSort == "name" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="client" asp-route-sortDesc="@(currentSort == "client" && !currentDesc)" asp-route-searchTerm="@searchTerm" asp-route-speciesId="@speciesId">
                    Client @(currentSort == "client" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="species" asp-route-sortDesc="@(currentSort == "species" && !currentDesc)" asp-route-searchTerm="@searchTerm" asp-route-speciesId="@speciesId">
                    Species @(currentSort == "species" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="breed" asp-route-sortDesc="@(currentSort == "breed" && !currentDesc)" asp-route-searchTerm="@searchTerm" asp-route-speciesId="@speciesId">
                    Breed @(currentSort == "breed" ? (currentDesc ? "\u25BC" : "\u25B2") : "")
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Id
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">
                    @Html.DisplayFor(modelItem => item.Name)
                </a>
            </td>
            <td>
                <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.ClientId">
                    @Html.DisplayFor(modelItem => item.Client.FullName)
                </a>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Species.Icon)
                @Html.DisplayFor(modelItem => item.Species.Name)
            </td>
            <td>
                @(item.Breed?.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<partial name="_PaginationPartial" />
